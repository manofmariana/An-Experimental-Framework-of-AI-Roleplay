    "segments": [{ "kind": "entry", "pass": { "template": "{_content}" } }]
  },
  "time": {
    "description": "结构时间机械渲染文本",
    "source": "clock",
    "segments": [{ "kind": "entry", "pass": { "template": "{_content}" } }]
  },
  "cast": {
    "description": "演员表（@CID ↔ 显示名；角色视角自身标「我」）",
    "source": "cast",
    "segments": [{ "kind": "entry", "pass": { "template": "{_content}" }, "separator": "\n" }]
  },
  "contacts": {
    "description": "可联系对象列表（后台且未持有频道；角色自身持频道或待答邀请时整体不可见）",
