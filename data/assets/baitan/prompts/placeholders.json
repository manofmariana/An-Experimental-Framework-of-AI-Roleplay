{
  "setting": {
    "description": "世界设定全文",
    "source": "setting",
    "segments": [{ "kind": "entry", "pass": { "template": "{_content}" } }]
  },
  "tone_card": {
    "description": "世界基调卡全文",
    "source": "tone_card",
    "segments": [{ "kind": "entry", "pass": { "template": "{_content}" } }]
  },
  "lore": {
    "description": "世界知识（角色 = 自身标签激活；GM = Lorebook 全文；正文 = 本轮参与者标签触发）",
    "source": "lore",
    "segments": [{ "kind": "entry", "pass": { "template": "{_content}" } }]
  },
  "events": {
    "description": "已裁决事件（角色 = 可见事件按读者身份替换；GM = 全量 @CID 原文；正文 = 近期窗口按演员表渲染）",
    "source": "events",
    "segments": [{ "kind": "entry", "pass": { "template": "{_content}" }, "separator": "\n" }]
  },
  "current_scene": {
    "description": "本轮未裁决言行（角色视角带同值批隔离与突发前缀）",
    "source": "working_set",
    "segments": [{ "kind": "entry", "pass": { "template": "{_content}" } }]
  },
  "prose_window": {
    "description": "正文滑窗（角色 = 同场景连续窗；GM = 连续场景窗；正文 = 全量连续文风窗）",
    "source": "prose_window",
    "segments": [{ "kind": "entry", "pass": { "template": "{_content}" }, "separator": "\n\n" }]
  },
  "last_prose": {
    "description": "上一轮正文",
