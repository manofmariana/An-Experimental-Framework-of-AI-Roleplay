{
  "name": "ofair",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open Framework of AI Roleplay (Ofair): roleplay framework built on async temporal scheduling, TAG-filtered declarative prompt assembly, and a custom variable/numeric-rule system (truth layer, not chat text)",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/server/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:unit": "tsx scripts/run-suite.ts unit",
    "test:contract": "tsx scripts/run-suite.ts contract",
    "test:application": "tsx scripts/run-suite.ts application",
    "test:integration": "tsx scripts/run-suite.ts integration",
    "test:fast": "tsx scripts/run-suite.ts unit",
    "test:arch": "tsx scripts/check-dependencies.ts",
    "check": "npm run typecheck && npm run test:arch && npm run test:fast",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^4.73.0",
    "ws": "^8.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
